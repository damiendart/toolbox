#!/usr/bin/env python3
"""
Checks Git repositories for dirty working directories and unpushed work.

If no issues were found with the specified Git repositories, the exit
status of this script will be 0. If issues were found, the exit status
will be 1. An exit status of 2 denotes that there was an error running
the script.
"""

# This file was written by Damien Dart, <damiendart@pobox.com>. This is
# free and unencumbered software released into the public domain. For
# more information, please refer to the accompanying "UNLICENCE" file.

import argparse
import concurrent.futures
import os
import pathlib
import subprocess
import sys
import typing


def check_repository(
    repository: str,
    treat_warnings_as_issues: bool,
) -> typing.Tuple[typing.List[str], typing.List[str]]:
    repository = os.path.abspath(repository)

    issues = []
    warnings = []

    def add_issue(s: str):
        issues.append('[✘] "{}": {}'.format(repository, s))

    def add_warning(s: str):
        if treat_warnings_as_issues:
            add_issue(s)
        else:
            warnings.append('[-] "{}": {}'.format(repository, s))

    if not os.path.exists(os.path.join(repository, ".git")):
        add_warning("Not a Git repository")

        return issues, warnings

    if run_git_command("git status --porcelain", repository):
        add_issue("Working directory is dirty")

    if run_git_command("git stash list", repository):
        add_issue("Repository has stashed modifications")

    branches = run_git_command(
        'git for-each-ref --format="%(refname:short)\t%(upstream:short)\t%(upstream:trackshort)" refs/heads',  # noqa: E501
        repository,
    )

    for branch in branches.splitlines():
        [name, upstream_branch_name, status] = branch.split("\t")
        error_base = 'Branch "{}" has '.format(name)

        if not upstream_branch_name:
            add_issue(error_base + "no corresponding upstream branch")

            continue

        if ">" in status:
            add_issue(error_base + "unpushed commits")

    return issues, warnings


def main(args: argparse.Namespace) -> None:
    issues_found = False

    with concurrent.futures.ThreadPoolExecutor(max_workers=5) as e:
        futures = {
            e.submit(check_repository, d, args.treat_warnings_as_issues)
            for d in args.repositories
        }

        for future in concurrent.futures.as_completed(futures):
            if future.result():
                issues, warnings = future.result()

                if len(issues) > 0:
                    issues_found = True

                for issue in issues:
                    print(issue)

                for warning in warnings:
                    print(warning)

    if issues_found:
        sys.exit(1)


def parse_arguments(arguments: typing.List[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    parser.add_argument(
        "--treat-warnings-as-issues",
        action="store_true",
        dest="treat_warnings_as_issues",
        help="treat warnings as issues",
    )

    parser.add_argument(
        "repositories",
        default=["."],
        help="local git repositories to check",
        nargs="*",
        type=pathlib.Path,
    )

    return parser.parse_args(arguments)


def run_git_command(command: str, cwd: str) -> str:
    try:
        output = subprocess.check_output(
            command,
            cwd=cwd,
            shell=True,
            stderr=subprocess.STDOUT,
        )
    except subprocess.CalledProcessError as e:
        if isinstance(e.output, bytes):
            e.output = e.output.decode("utf-8")

        print(
            '{}: git error: "{}"'.format(
                os.path.basename(sys.argv[0]),
                e.output.splitlines()[0],
            ),
            file=sys.stderr,
        )

        raise SystemExit(2)

    return output.decode("utf-8") if isinstance(output, bytes) else output


if __name__ == "__main__":
    arguments = parse_arguments(sys.argv[1:])

    main(arguments)
